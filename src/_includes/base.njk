<!DOCTYPE html>
<html lang="en">
<baseline-head></baseline-head>
  <body>
    <header>
      <div class="wrapper">{% include "components/c-navigation.njk" %}</div>
    </header>

    <main class="page">
      <div class="wrapper">
        {% include "components/c-breadcrumbs.njk" %}
      </div>
      <div class="flow wrapper">
        <h1>{{ title }}</h1>
        {{ content | safe }}
      </div>
      <div class="wrapper">
        {% include "components/c-page-navigation.njk" %}
      </div>
    </main>

    <footer>
      <div class="wrapper">
        {% include "components/c-footer.njk" %}
      </div>
    </footer>

    {# The theme switch. The pre-paint restore is separate, and inline in
       <head>, so the attribute lands before the body renders. #}
    <script src="/assets/js/index.js" defer></script>
  </body>
</html>
